{
 "CFGNorm": {
  "input": {
   "optional": {
    "pre_cfg": [
     "BOOLEAN",
     {
      "default": false,
      "tooltip": "If true, rescale the combined noise BEFORE the sampler's CFG combine, without clamping (can amplify). Matches the norm-scaled CFG used by models like Lens. Default false keeps the original post-CFG x0-space attenuate-only behavior."
     }
    ]
   },
   "required": {
    "model": [
     "MODEL",
     {}
    ],
    "strength": [
     "FLOAT",
     {
      "default": 1.0,
      "max": 100.0,
      "min": 0.0,
      "step": 0.01
     }
    ]
   }
  },
  "output": [
   "MODEL"
  ]
 },
